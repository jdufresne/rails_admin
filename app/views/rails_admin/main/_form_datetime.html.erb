<div class="row">
  <div class="col-sm-4">
    <% if field.type.in?([:datetime, :timestamp]) %>
      <%= form.datetime_local_field field.method_name, field.html_attributes.reverse_merge({autocomplete: 'off', class: 'form-control', value: field.form_value}) %>
    <% elsif field.type == :date %>
      <%= form.date_field field.method_name, field.html_attributes.reverse_merge({autocomplete: 'off', class: 'form-control', value: field.form_value}) %>
    <% elsif field.type == :time %>
      <%= form.time_field field.method_name, field.html_attributes.reverse_merge({autocomplete: 'off', class: 'form-control', value: field.form_value}) %>
    <% end %>
  </div>
</div>
